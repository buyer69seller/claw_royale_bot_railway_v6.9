# Claw Royale Bot - Environment Variables

# ===== AUTHENTICATION =====
# Claw Royale API Key - WAJIB
CLAW_API_KEY=mr_live_xxxxxxxxxxxx

# ===== GAME CONFIG =====
# Entry type: free atau paid
ENTRY_TYPE=free

# Preferred mode: offchain atau onchain
PREFERRED_MODE=offchain

# Action interval (0.1 - 1.0 recommended)
ACTION_INTERVAL_SECONDS=0.25

# ===== STRATEGY =====
# Strategy mode: 'hybrid' atau 'scan_clear'
STRATEGY_MODE=hybrid

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===== REINFORCEMENT LEARNING =====
# Enable/disable RL
RL_ENABLED=true

# Learning rate (0.01-1.0)
RL_LEARNING_RATE=0.1

# Initial exploration rate
RL_EPSILON_START=1.0

# Final exploration rate
RL_EPSILON_END=0.05

# ===== MEMORY =====
# Max knowledge history entries
MAX_KNOWLEDGE_HISTORY=500# Max RL memory size
MAX_RL_MEMORY=1000

# ===== AUTO-EQUIP =====
# Auto-equip best items on startup
AUTO_EQUIP_ENABLED=true